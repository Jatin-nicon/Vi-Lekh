# Backend API URL (NestJS)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Access Control
NEXT_PUBLIC_SUPER_ADMIN_EMAIL=admin@vilekh.local

# Firebase Auth Emulator (Fully offline local development matching ViDo)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-vilekh
